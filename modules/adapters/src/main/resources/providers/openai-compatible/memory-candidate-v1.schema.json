{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": "memory-candidate.v1"},
    "candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_decision",
        "memory_type",
        "subject",
        "predicate",
        "value",
        "normalized_content",
        "event_time",
        "valid_interval",
        "importance",
        "confidence",
        "sensitivity",
        "candidate_relations"
      ],
      "properties": {
        "proposed_decision": {"enum": ["REMEMBER", "IGNORE", "REVIEW"]},
        "memory_type": {"enum": ["WORKING", "SEMANTIC", "EPISODIC", "PROCEDURAL"]},
        "subject": {"$ref": "#/$defs/subject"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "value": {"type": ["string", "number", "boolean"]},
        "normalized_content": {"type": "string", "minLength": 1, "maxLength": 8192},
        "event_time": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time_range"}]},
        "valid_interval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time_range"}]},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": [
              "NONE",
              "LOCATION",
              "CONTACT",
              "AUTH_SECRET",
              "CREDENTIAL",
              "HEALTH",
              "FINANCIAL",
              "IDENTITY",
              "BIOMETRIC"
            ]
          }
        },
        "candidate_relations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/relation"}
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {"enum": ["USER", "PROJECT", "AGENT"]},
        "label": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_text", "start", "end", "precision", "confidence"],
      "properties": {
        "original_text": {"type": ["string", "null"], "maxLength": 256},
        "start": {"type": ["string", "null"], "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"},
        "precision": {"enum": ["EXACT", "DAY", "MONTH", "YEAR", "UNKNOWN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_subject", "target_predicate"],
      "properties": {
        "type": {"enum": ["DUPLICATES", "REINFORCES", "SUPERSEDES", "COEXISTS", "CONFLICTS"]},
        "target_subject": {"type": "string", "minLength": 1, "maxLength": 256},
        "target_predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}
      }
    }
  }
}
