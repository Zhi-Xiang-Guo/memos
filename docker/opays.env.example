# Copy to .env for a local Docker deployment. Fill OPAY_LLM_API_KEY separately.
MEMOS_DB_NAME=memos
MEMOS_DB_USER=memos
MEMOS_DB_PASSWORD=memos-local
MEMOS_DB_PORT=15432
MEMOS_DB_URL=jdbc:postgresql://localhost:15432/memos
MEMOS_API_PORT=18080
MEMOS_WORKER_PORT=18081
MEMOS_JWT_ISSUER=memos-local
MEMOS_JWT_AUDIENCE=memos-api
MEMOS_JWT_HMAC_SECRET=replace-with-at-least-32-random-bytes
OPAY_LLM_API_KEY=
MEMOS_EXTRACTION_PROVIDER=openai-compatible
MEMOS_EXTRACTION_BASE_URL=https://routers.opays.ai/api/v0/llm
MEMOS_EXTRACTION_API_KEY=${OPAY_LLM_API_KEY}
MEMOS_EXTRACTION_MODEL_TAG=deepseek-v4-flash@us
MEMOS_EXTRACTION_MODEL_VERSION=opays-deepseek-v4-flash-us-deploy-20260929
MEMOS_EXTRACTION_PROMPT_VERSION=candidate-extraction-v2
MEMOS_EXTRACTION_TIMEOUT=120s
MEMOS_EMBEDDING_PROVIDER=openai-compatible
MEMOS_EMBEDDING_BASE_URL=https://routers.opays.ai/api/v0/llm
MEMOS_EMBEDDING_API_KEY=${OPAY_LLM_API_KEY}
MEMOS_EMBEDDING_MODEL_TAG=nebius/Qwen/Qwen3-Embedding-8B
MEMOS_EMBEDDING_MODEL_VERSION=opays-qwen3-embedding-8b-1024-deploy-20260929
MEMOS_EMBEDDING_DIMENSIONS=1024
MEMOS_EMBEDDING_TIMEOUT=60s
MEMOS_RERANKING_ENABLED=false
MEMOS_RERANKER_MODEL_VERSION=pass-through-v1
MEMOS_WORKER_BATCH_SIZE=4
MEMOS_WORKER_POLL_DELAY=1s
